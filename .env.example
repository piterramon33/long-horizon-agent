# --- model --------------------------------------------------------------
# openrouter: one key, hundreds of models. Or "openai" for any OpenAI-compatible endpoint.
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-5-mini
# Only used when LLM_PROVIDER=openai:
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- sandbox ------------------------------------------------------------
# docker: throwaway container per code run (needs Docker Desktop running)
# e2b:    cloud microVM (pip install e2b-code-interpreter, set E2B_API_KEY)
# local:  plain subprocess, NOT isolated; refused unless ALLOW_LOCAL_SANDBOX=1
SANDBOX=docker
DOCKER_IMAGE=python:3.12-slim
E2B_API_KEY=
EXEC_TIMEOUT=30

# --- guardrails ---------------------------------------------------------
# ask: prompt in the terminal before risky actions | deny: always refuse | allow: never ask
APPROVAL=ask
WEB=on
MAX_ROUNDS=8
MAX_STEPS=60
MAX_TOKENS=500000
MAX_COST_USD=0.50
# Longest answer one model call may write. OpenRouter holds back credit for this much
# on every request, so a low balance fails with HTTP 402 if it is too high.
MAX_OUTPUT_TOKENS=8192
SUBAGENT_MAX_REQUESTS=15
MAX_PARALLEL=3

# Price per million tokens, only if your endpoint does not report cost.
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=
